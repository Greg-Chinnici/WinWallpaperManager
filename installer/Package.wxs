<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    Per-user install: no admin prompt, files go to %LOCALAPPDATA%\Programs\WinWallpaper.
    Upgrades replace older versions in place (MajorUpgrade + fixed UpgradeCode).
    User data in %LOCALAPPDATA%\WinWallpaper (state.json, logs) is left alone on uninstall.
  -->
  <Package Name="WinWallpaper"
           Manufacturer="WinWallpaper"
           Version="$(var.Version)"
           UpgradeCode="FC1BC53A-3906-42B2-B783-00217CA2CF8B"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of WinWallpaper is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.AssetsDir)\WinWallpaper.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Live wallpapers for Windows 11 (early development preview)" />

    <!-- Files are in use while the wallpaper runs: stop the processes before install/upgrade/uninstall.
         The host gets WM_CLOSE so it detaches and repaints the normal wallpaper; the daemon and tray
         have no closable window for this, so they are terminated. -->
    <util:CloseApplication Id="CloseTray" Target="WallpaperTray.exe" TerminateProcess="0" RebootPrompt="no" />
    <util:CloseApplication Id="CloseDaemon" Target="WallpaperDaemon.exe" TerminateProcess="0" RebootPrompt="no" />
    <util:CloseApplication Id="CloseHost" Target="WallpaperHost.exe" CloseMessage="yes" TerminateProcess="0" RebootPrompt="no" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="WinWallpaper" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="WinWallpaper" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="StartAtSignIn" />
      <ComponentRef Id="InstallFolderCleanup" />
    </Feature>
  </Package>

  <Fragment>
    <!-- Everything build/publish.ps1 produced. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
      <Shortcut Id="AppShortcut" Name="WinWallpaper" Description="Live wallpapers for your desktop"
                Target="[INSTALLFOLDER]WallpaperTray.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\WinWallpaper" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Start in the tray at sign-in; the daemon then restores the last wallpaper. -->
    <Component Id="StartAtSignIn" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="WinWallpaper"
                     Type="string" Value="&quot;[INSTALLFOLDER]WallpaperTray.exe&quot; --background" KeyPath="yes" />
    </Component>

    <Component Id="InstallFolderCleanup" Directory="INSTALLFOLDER" Guid="*">
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\WinWallpaper" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
